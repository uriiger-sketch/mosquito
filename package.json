{
  "name": "mosquitonet",
  "version": "3.0.0",
  "private": true,
  "description": "Acoustic mosquito surveillance PWA \u2014 on-device detection, crowdsourced vector map.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "bench": "node tools/detection_bench.js",
    "bench:quick": "node tools/detection_bench.js --quick",
    "serve": "http-server -p 8080 -c-1 .",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.js\"",
    "eval": "node tools/eval/eval.js --full",
    "eval:quick": "node tools/eval/eval.js --quick --check",
    "eval:report": "node tools/eval/report.js"
  }
}
